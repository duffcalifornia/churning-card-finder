# Copy to .env.local for local testing of api/suggest.ts with `vercel dev` (never commit .env.local — it's
# gitignored already). In production this is set in the hosting platform's own environment variable settings,
# never in a file. See docs/deployment.md for how to create the token.
GITHUB_TOKEN=

# Optional: direct email notification when a suggestion comes in, via Resend (https://resend.com). GitHub does
# not email GITHUB_TOKEN's own owner about issues that token created, so without this, suggestions only show up
# if you go looking at the repo's Issues tab. Leave both unset to skip email entirely — the GitHub issue is still
# created either way. See docs/deployment.md for setup.
RESEND_API_KEY=
SUGGESTION_NOTIFY_EMAIL=
# Optional: defaults to onboarding@resend.dev (Resend's shared test sender - see docs/deployment.md for its limits).
RESEND_FROM_EMAIL=

# Optional: referral links shown on the unlisted "Support this project" page (src/ui/ReferralsPage.tsx). Read at
# BUILD time via Vite's import.meta.env, not runtime — they end up in the built JS bundle same as a hardcoded
# string would (they're not secret from site visitors; that's the point of a referral link), so setting these
# here isn't about hiding the values, it's so that swapping a link out later is a Vercel dashboard edit with no
# commit, rather than a diff sitting in git history forever. Leave any of them unset to just not show that entry
# (all unset falls back to "No referral links added yet."). See docs/deployment.md for where to set these in Vercel.
VITE_REFERRAL_CHASE_SAPPHIRE=
VITE_REFERRAL_CHASE_MARRIOTT=
VITE_REFERRAL_CHASE_INK=
VITE_REFERRAL_AMEX=
